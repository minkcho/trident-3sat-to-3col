import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.GroupTheory.GroupAction.Basic
import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Tactic.IntervalCases

/-!
  # The orbit types of the paper's Lemma 6, in Mathlib terms

  The symmetric group S3 is `Equiv.Perm (Fin 3)`. The proof follows the
  paper: by Lagrange's theorem a point stabilizer has order 6, 3, 2 or 1;
  it is then the whole group, the alternating group, the stabilizer of an
  index, or the trivial group (`subgroup_cases`); and by the
  orbit-stabilizer theorem the orbit has size 1, 2, 3 or 6 and carries the
  trivial, sign, natural or free action (`orbit_structure`).

  The statements of Lemma 6 about the edges inside an orbit of size 3 and
  about literal attachments are not in this file; the proof of Theorem 16 by
  search does not need them.

  Mathlib only; the search engine is not used.
-/

namespace Def1

open MulAction

/-- S3 has six elements. -/
theorem card_perm_fin_three : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
  rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
  rfl

/-- An involution of three points fixes one of them. -/
theorem exists_fixed_of_sq_eq_one (τ : Equiv.Perm (Fin 3)) (h : τ ^ 2 = 1) :
    ∃ k, τ k = k := by
  by_contra hno
  have hno' : ∀ k, τ k ≠ k := fun k hk => hno ⟨k, hk⟩
  have hsq : ∀ x, τ (τ x) = x := fun x => by
    have h2 := congrArg (fun f : Equiv.Perm (Fin 3) => f x) h
    simpa [pow_two] using h2
  -- a third point `k`, different from `0` and from `τ 0`
  have hthird : ∀ j : Fin 3, ∃ k : Fin 3, k ≠ 0 ∧ k ≠ j := by decide
  obtain ⟨k, hk0, hkj⟩ := hthird (τ 0)
  -- three distinct points of `Fin 3` are all of its points
  have hall : ∀ a b c : Fin 3, a ≠ b → a ≠ c → b ≠ c →
      ∀ x, x = a ∨ x = b ∨ x = c := by decide
  rcases hall 0 (τ 0) k (fun h0 => hno' 0 h0.symm) (fun h0 => hk0 h0.symm)
      (fun h0 => hkj h0.symm) (τ k) with h1 | h1 | h1
  · exact hkj (τ.injective (h1.trans (hsq 0).symm))
  · exact hk0 (τ.injective h1)
  · exact hno' k h1

/-- The stabilizer of an index under the natural action has two elements
    (orbit-stabilizer: the orbit is all of `Fin 3`). -/
theorem card_stabilizer_index (k : Fin 3) :
    Nat.card (stabilizer (Equiv.Perm (Fin 3)) k) = 2 := by
  have h := Nat.card_congr (orbitProdStabilizerEquivGroup (Equiv.Perm (Fin 3)) k)
  rw [Nat.card_prod, card_perm_fin_three, orbit_eq_univ,
    Nat.card_congr (Equiv.Set.univ (Fin 3)), Nat.card_eq_fintype_card,
    Fintype.card_fin] at h
  omega

/-- The subgroups of S3 (the classification behind Lemma 6): a subgroup has
    order 6, 3, 2 or 1 by Lagrange's theorem, and it is then the whole group,
    the alternating group, the stabilizer of an index, or the trivial
    group. -/
theorem subgroup_cases (H : Subgroup (Equiv.Perm (Fin 3))) :
    (Nat.card H = 6 ∧ H = ⊤) ∨
    (Nat.card H = 3 ∧ H = alternatingGroup (Fin 3)) ∨
    (Nat.card H = 2 ∧ ∃ k : Fin 3, H = stabilizer (Equiv.Perm (Fin 3)) k) ∨
    (Nat.card H = 1 ∧ H = ⊥) := by
  have hdvd : Nat.card H ∣ 6 := by
    have h := Subgroup.card_subgroup_dvd_card H
    rwa [card_perm_fin_three] at h
  have hdiv : ∀ n : Nat, n ∣ 6 → n = 1 ∨ n = 2 ∨ n = 3 ∨ n = 6 := by
    intro n hn
    have hle : n ≤ 6 := Nat.le_of_dvd (by norm_num) hn
    interval_cases n <;> omega
  rcases hdiv _ hdvd with h | h | h | h
  · exact Or.inr (Or.inr (Or.inr ⟨h, Subgroup.eq_bot_of_card_eq H h⟩))
  · -- order 2: generated by an involution, which fixes an index
    refine Or.inr (Or.inr (Or.inl ⟨h, ?_⟩))
    have hne : H ≠ ⊥ := by
      intro hb
      rw [hb, Subgroup.card_bot] at h
      omega
    obtain ⟨τ, hτ, hτ1⟩ : ∃ τ ∈ H, τ ≠ 1 := by
      by_contra hno
      apply hne
      rw [Subgroup.eq_bot_iff_forall]
      intro x hx
      by_contra hx1
      exact hno ⟨x, hx, hx1⟩
    have hτ2 : τ ^ 2 = 1 := by
      have hpow : (⟨τ, hτ⟩ : H) ^ Nat.card H = 1 := pow_card_eq_one'
      rw [h] at hpow
      have := congrArg Subtype.val hpow
      simpa using this
    obtain ⟨k, hk⟩ := exists_fixed_of_sq_eq_one τ hτ2
    have hord : orderOf τ = 2 := orderOf_eq_prime hτ2 hτ1
    have hz : Nat.card (Subgroup.zpowers τ) = 2 := by rw [Nat.card_zpowers, hord]
    have hH : Subgroup.zpowers τ = H :=
      Subgroup.eq_of_le_of_card_ge ((Subgroup.zpowers_le).mpr hτ) (by rw [h, hz])
    have hK : Subgroup.zpowers τ = stabilizer (Equiv.Perm (Fin 3)) k :=
      Subgroup.eq_of_le_of_card_ge
        ((Subgroup.zpowers_le).mpr (mem_stabilizer_iff.mpr hk))
        (by rw [card_stabilizer_index, hz])
    exact ⟨k, hH.symm.trans hK⟩
  · -- order 3: index 2, hence the alternating group
    refine Or.inr (Or.inl ⟨h, Equiv.Perm.eq_alternatingGroup_of_index_eq_two ?_⟩)
    have hidx := H.index_mul_card
    rw [h, card_perm_fin_three] at hidx
    omega
  · exact Or.inl ⟨h, Subgroup.eq_top_of_card_eq H (by rw [h, card_perm_fin_three])⟩

/-- The orbit types of Lemma 6. Let S3 act on a set and let `a` be a point.
    Then one of the following holds.
    1. The orbit of `a` has size 1: every permutation fixes `a`.
    2. The orbit has size 2 and carries the sign action: a permutation
       fixes `a` exactly when it is even.
    3. The orbit has size 3 and carries the natural action: for some index
       `k`, a permutation fixes `a` exactly when it fixes `k`.
    4. The orbit has size 6 and is free: only the identity fixes `a`. -/
theorem orbit_structure {X : Type*} [MulAction (Equiv.Perm (Fin 3)) X] (a : X) :
    (Nat.card (orbit (Equiv.Perm (Fin 3)) a) = 1 ∧
      ∀ σ : Equiv.Perm (Fin 3), σ • a = a) ∨
    (Nat.card (orbit (Equiv.Perm (Fin 3)) a) = 2 ∧
      ∀ σ : Equiv.Perm (Fin 3), σ • a = a ↔ Equiv.Perm.sign σ = 1) ∨
    (Nat.card (orbit (Equiv.Perm (Fin 3)) a) = 3 ∧
      ∃ k : Fin 3, ∀ σ : Equiv.Perm (Fin 3), σ • a = a ↔ σ k = k) ∨
    (Nat.card (orbit (Equiv.Perm (Fin 3)) a) = 6 ∧
      ∀ σ : Equiv.Perm (Fin 3), σ • a = a ↔ σ = 1) := by
  -- orbit-stabilizer: |orbit| * |stabilizer| = 6
  have hos : Nat.card (orbit (Equiv.Perm (Fin 3)) a) *
      Nat.card (stabilizer (Equiv.Perm (Fin 3)) a) = 6 := by
    have h := Nat.card_congr (orbitProdStabilizerEquivGroup (Equiv.Perm (Fin 3)) a)
    rwa [Nat.card_prod, card_perm_fin_three] at h
  rcases subgroup_cases (stabilizer (Equiv.Perm (Fin 3)) a) with
    ⟨hc, hH⟩ | ⟨hc, hH⟩ | ⟨hc, k, hH⟩ | ⟨hc, hH⟩
  · refine Or.inl ⟨by rw [hc] at hos; omega, fun σ => ?_⟩
    have hσ : σ ∈ stabilizer (Equiv.Perm (Fin 3)) a := by rw [hH]; exact Subgroup.mem_top σ
    exact mem_stabilizer_iff.mp hσ
  · refine Or.inr (Or.inl ⟨by rw [hc] at hos; omega, fun σ => ?_⟩)
    rw [← mem_stabilizer_iff, hH, Equiv.Perm.mem_alternatingGroup]
  · refine Or.inr (Or.inr (Or.inl ⟨by rw [hc] at hos; omega, k, fun σ => ?_⟩))
    rw [← mem_stabilizer_iff, hH, mem_stabilizer_iff, Equiv.Perm.smul_def]
  · refine Or.inr (Or.inr (Or.inr ⟨by rw [hc] at hos; omega, fun σ => ?_⟩))
    rw [← mem_stabilizer_iff, hH, Subgroup.mem_bot]

/-- Labeling an orbit: a function on the group that takes equal values
    exactly on the permutations that move `a` to the same point gives a
    function on the orbit of `a`, injective there. -/
theorem exists_orbit_labeling {G X L : Type*} [Group G] [MulAction G X] (a : X)
    (f : G → L) (hf : ∀ σ τ : G, σ • a = τ • a ↔ f σ = f τ) :
    ∃ lab : X → L, (∀ σ : G, lab (σ • a) = f σ) ∧
      ∀ x ∈ orbit G a, ∀ y ∈ orbit G a, lab x = lab y → x = y := by
  classical
  let lab : X → L := fun x =>
    if h : ∃ σ : G, σ • a = x then f (Classical.choose h) else f 1
  have hlab : ∀ σ : G, lab (σ • a) = f σ := by
    intro σ
    have h : ∃ τ : G, τ • a = σ • a := ⟨σ, rfl⟩
    show (if h : ∃ τ : G, τ • a = σ • a then f (Classical.choose h) else f 1) = f σ
    rw [dif_pos h]
    exact (hf _ _).mp (Classical.choose_spec h)
  refine ⟨lab, hlab, ?_⟩
  rintro x ⟨σ, rfl⟩ y ⟨τ, rfl⟩ hxy
  have hxy' : f σ = f τ := by
    have h1 := hlab σ
    have h2 := hlab τ
    simp only at hxy
    rw [← h1, ← h2]
    exact hxy
  exact (hf σ τ).mpr hxy'

end Def1
